# Network Configuration Example
# Copy this to .env.local and replace YOUR_IP with your actual IP address

# For network access, set these environment variables:
# VITE_API_URL=http://YOUR_IP:3001/api
# VITE_SERVER_URL=http://YOUR_IP:3001

# Example with real IP (replace with your actual IP):
# VITE_API_URL=http://192.168.1.100:3001/api
# VITE_SERVER_URL=http://192.168.1.100:3001

# For local development only:
# VITE_API_URL=http://localhost:3001/api
# VITE_SERVER_URL=http://localhost:3001
