# Environment
NODE_ENV=development
PORT=3001

# Database
DATABASE_URL=

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Social Blade API
# Get your credentials from https://socialblade.com/developers
SOCIAL_BLADE_CLIENT_ID=your-client-id
SOCIAL_BLADE_TOKEN=your-client-secret
SOCIAL_BLADE_BASE_URL=https://matrix.sbapis.com/b

# YouTube Analytics API
# Get credentials from https://console.cloud.google.com/apis/credentials
YOUTUBE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your-google-oauth-client-secret
YOUTUBE_REDIRECT_URI=http://localhost:3001/api/youtube/oauth2callback

# CORS
CORS_ORIGIN=http://localhost:5173

# Default Admin
DEFAULT_ADMIN_EMAIL=admin@koc.vn
DEFAULT_ADMIN_PASSWORD=Admin@123456

# ── Chrome CDP Mode (Real Chrome - recommended for local/stable scraping) ──
# When set, scraper connects to real Chrome via CDP instead of Playwright Chromium
# This gives native browser fingerprint → Google cannot detect automation
# Session can last months without re-login
# Usage: click "Mở trình duyệt" in UI → Chrome opens → login → click "Xác nhận"
# CHROME_CDP_URL=http://localhost:9222

# Optional: path to Chrome/Chromium executable (auto-detected on macOS/Linux)
# CHROME_EXECUTABLE_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# ── GoLogin Anti-detect Browser (Local / Free plan) ──
# Không cần API token hay Profile ID — dùng Orbita browser đã tải qua GoLogin desktop app.
# Orbita browser tự động tìm tại: ~/.gologin/browser/orbita-browser-*/
#
# Chạy ẩn (true) hay hiện browser (false). Mặc định: false (hiện browser để login)
# GOLOGIN_HEADLESS=false
#
# Remote debugging port (mặc định: 9223, tránh xung đột với Chrome 9222)
# GOLOGIN_CDP_PORT=9223
#
# Thư mục lưu profile Orbita (mặc định: ~/.gologin/local-profiles/default)
# GOLOGIN_PROFILE_DIR=/Users/anhduc/.gologin/local-profiles/default

# ── GemLogin Anti-detect Browser (HTTP API) ──
# GemLogin chạy local và expose REST API. Service tự inject CHROME_CDP_URL khi start profile.
#
# URL của GemLogin API (mặc định: http://localhost:7003)
# GEMLOGIN_API_URL=http://localhost:1010
#
# Profile ID mặc định (dùng khi gọi POST /api/gemlogin/start mà không truyền profileId)
# GEMLOGIN_PROFILE_ID=your-profile-id

# ── Auto-login Google khi browser session hết hạn ───────────────────────────
# Khi scraper bị redirect sang accounts.google.com, GoogleAutoLoginService sẽ tự
# fill email + password + mã 2FA. Bỏ trống để TẮT (sẽ throw NOT_LOGGED_IN như cũ).
#
# GOOGLE_EMAIL=youraccount@gmail.com
# GOOGLE_PASSWORD=your-account-password
#
# Mã 2FA — paste secret base32 lấy lúc bật Authenticator trên Google
# ("Set up authenticator" → "Can't scan it?" → copy chuỗi base32, bỏ space).
# Mã 6 số được lấy qua API https://2fa.live/tok/{secret} mỗi lần auto-login.
# CẢNH BÁO: secret bị gửi lên server 2fa.live qua HTTPS — nếu họ log lại = lộ account.
# GOOGLE_TOTP_SECRET=abcdefghijklmnopqrstuvwxyz234567

# AES key cho encrypt credentials lưu DB (32 bytes hex). Sinh bằng:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SETTING_ENCRYPTION_KEY=

# Timeout scrape (ms) — máy yếu / mạng chậm tăng lên.
# SCRAPE_GOTO_TIMEOUT_MS=300000   # page.goto YT Studio (mặc định 5 phút)
# SCRAPE_POLL_TIMEOUT_MS=600000   # deadline đợi bảng analytics (mặc định 10 phút)
